{
  "name": "jb-loading",
  "description": "loading web component",
  "type": "module",
  "author": {
		"name": "mohammad javad bathaei",
		"email": "javadbat@gmail.com"
	},
  "keywords": [
    "jb",
    "jb-loading",
    "loading",
    "web component"
  ],
  "version": "2.1.1",
  "bugs": "https://github.com/javadbat/jb-loading/issues",
  "license": "MIT",
  "files": [
    "LICENSE",
    "README.md",
    "web-component/custom-elements.json",
    "web-component/lib/",
    "web-component/dist/",
    "react/",
    "react/dist/"
  ],
  "main": "index.js",
  "types": "./web-component/dist/jb-loading.d.ts",
  "exports": {
    ".": {
      "types": "./web-component/dist/jb-loading.d.ts",
      "default": "./index.js"
    },
    "./react": {
      "types": "./react/dist/JBLoading.d.ts",
      "default": "./react/index.js"
    },
    "./*": "./*"
  },
  "customElements": "web-component/custom-elements.json",
  "dependencies": {
    "jb-core":"^0.37.0"
  },
  "repository": {
		"type": "git",
		"url": "https://github.com/javadbat/jb-loading.git"
  }
}
